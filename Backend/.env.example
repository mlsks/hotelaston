# Réglages du back-office (copier en .env). Toutes les valeurs sont facultatives : la valeur par défaut est indiquée.
# Ne jamais mettre de mot de passe ici : les comptes se créent avec « node server/cli.js user:add ».

# Serveur
HOST=127.0.0.1
PORT=3020
# Adresse publique du site (sitemap, canonical, hreflang)
SITE_URL=https://www.hotel-aston.com
SITE_TZ=Europe/Paris
# Régénération de nuit (format cron)
CRON_REBUILD=0 0 * * *
SESSION_HOURS=12

# Dossier des données modifiables (base, médias, versions). Par défaut : le dossier Backend/ lui-même.
# ASTON_VAR_DIR=/data

# Clé IndexNow (vide : pas de notification aux moteurs)
INDEXNOW_KEY=

# Démo hébergée (Render…) : NOINDEX=1 interdit l'indexation de tout le site (en-tête X-Robots-Tag, robots.txt fermé).
# DEMO_PASSWORD ferme tout le site par un mot de passe du navigateur (nom d'utilisateur au choix) et implique NOINDEX.
# Sous Render, HOST vaut 0.0.0.0 par défaut (variable RENDER posée par la plateforme).
NOINDEX=0
DEMO_PASSWORD=

# Développement : sert la maquette d'origine sur /legacy/
SERVE_LEGACY=0

# Vidéos
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Poids maximal au téléversement (Mo)
UPLOAD_MAX_IMAGE_MB=25
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_AUDIO_MB=30

# Avis Google : synchronisation par l'API Google Business Profile (voir Backend/README.md, « Avis Google »).
# Tant que ces valeurs sont vides, les avis s'ajoutent à la main dans l'admin (Avis Google).
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
# Synchronisation planifiée (format cron, vide : jamais), suivie de la publication des seuls avis
GBP_SYNC_CRON=
